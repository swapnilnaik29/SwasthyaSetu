# Application
APP_ENV=development
APP_NAME=SwasthyaSetu
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=swasthyasetu-super-secret-key-32-chars-long-demo
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,*

# Database (PostgreSQL recommended; SQLite fallback supported)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/swasthyasetu

# Gnani — STT (Prisma v2.5) and TTS (Timbre v2.5)
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
GNANI_STT_MODE=rest
GNANI_TTS_MODE=rest
GNANI_DEFAULT_VOICE_HI=hi_female_1
GNANI_DEFAULT_VOICE_MR=mr_female_1
GNANI_DEFAULT_VOICE_EN=en_female_1
# Legacy credentials if required by older Gnani account:
GNANI_LEGACY_TOKEN=
GNANI_LEGACY_ACCESS_KEY=
GNANI_LEGACY_CERT_PATH=

# OpenAI GPT-6 Luna — Text translation and structured draft extraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_API_MODE=responses
OPENAI_REASONING_EFFORT=none
TRANSLATION_PROMPT_VERSION=v1
TRANSLATION_CACHE_TTL_DAYS=90
TRANSLATION_CACHE_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZW5jcnlwdGlvbi1rZXk=
TRANSLATION_CACHE_HMAC_KEY=swasthyasetu-hmac-secret-salt-demo-2026

# SMS Provider (mock for offline/demo development)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=SWASTH
SMS_BASE_URL=

# Audio / retention
MAX_AUDIO_MB=20
AUDIO_TEMP_DIR=./tmp/audio
RETAIN_AUDIO=false
AUDIO_RETENTION_HOURS=0

# Clinic display settings
CLINIC_DISPLAY_NAME=SwasthyaSetu Demo Clinic
CLINIC_CONTACT_NUMBER=+919876543210
